---
import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "Joel Jarro — Software Engineer";
const description =
  "Software engineer in La Paz, Bolivia. Backend and full-stack systems in TypeScript, NestJS, Node.js and Java 21 with Spring Boot, third-party platform integrations, and data correctness where approximately right is a failure.";
const url = "https://quirrod.github.io/myfolio/";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="author" content="Joel Jarro" />
<meta name="description" content={description} />
<meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
<link rel="canonical" href={url} />

<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${base}/me.jpeg`} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<link rel="icon" href={`${base}/me.jpeg`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  (function () {
    try {
      var s = localStorage.getItem("theme");
      var dark = s ? s === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
    } catch (e) {}
  })();
</script>
