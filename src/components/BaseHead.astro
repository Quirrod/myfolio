---
import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "Joel Jarro — React & Full-Stack Engineer";
const description =
  "Software engineer in La Paz, Bolivia, open to remote. React and TypeScript web products with the Node.js, NestJS and Java 21 backend behind them, third-party platform integrations, and data correctness where approximately right is a failure.";
const url = "https://quirrod.github.io/myfolio/";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="author" content="Joel Jarro" />
<meta name="description" content={description} />
<meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
<link rel="canonical" href={url} />

<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${base}/me.jpeg`} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<link rel="icon" href={`${base}/me.jpeg`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  (function () {
    try {
      var s = localStorage.getItem("theme");
      var dark = s ? s === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
    } catch (e) {}
    /* Content is visible by default; only hide it for the reveal animation once JS runs,
       and show everything if the reveal script has not run within 3 s. */
    document.documentElement.classList.add("js");
    setTimeout(function () {
      document.querySelectorAll("[data-reveal]:not(.is-visible)").forEach(function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < window.innerHeight) el.classList.add("is-visible");
      });
    }, 3000);
  })();
</script>
