---
import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "Joel Jarro — Software Engineer";
const description =
  "Software engineer in La Paz, Bolivia. Backend and full-stack systems in TypeScript, NestJS, Node.js and Java 21 with Spring Boot, third-party platform integrations, and data correctness where approximately right is a failure.";
const url = "https://quirrod.github.io/myfolio/";
const ogImage = `${base}/me.jpeg`;
---

<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="author" content="Joel Jarro" />
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="theme-color" content="#0b0b0e" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<link rel="canonical" href={url} />

<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<link rel="icon" href={`${base}/me.jpeg`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  // Set theme before first paint so there is no flash.
  (function () {
    try {
      var stored = localStorage.getItem("theme");
      var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.classList.toggle("dark", dark);
    } catch (e) {
      /* private mode: fall back to light */
    }
  })();
</script>
