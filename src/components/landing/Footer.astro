---
const year = new Date().getFullYear();
---
<section id="contact" class="section">
  <div class="contact" data-reveal data-tilt>
    <div class="card-glow"></div>
    <p class="eyebrow">04 — Contact</p>
    <h2 class="contact-title">Let's build something<br /><em>worth getting right.</em></h2>
    <p class="contact-text">
      I work remote and asynchronous from La Paz on UTC-4, which overlaps a full US working day.
      Email is the fastest way to reach me.
    </p>
    <div class="cta-row">
      <a href="mailto:joeljarro2@gmail.com" class="btn btn-primary">joeljarro2@gmail.com</a>
      <a href="https://github.com/Quirrod" target="_blank" rel="noopener" class="btn btn-ghost">GitHub</a>
      <a href="https://www.linkedin.com/in/joel-jarro/" target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn</a>
    </div>
  </div>
  <p class="colophon">© {year} Joel Jarro · Built with Astro and Tailwind</p>
</section>
