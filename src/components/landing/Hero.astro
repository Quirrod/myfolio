---
import { roles, stats } from "../../data/portfolio";
---
<section id="top" class="hero">
  <p class="badge" data-reveal>
    <span class="pulse"><span></span><span></span></span>
    La Paz, Bolivia · UTC-4 · open to remote
  </p>

  <h1 class="display" data-reveal style="--reveal-delay:60ms">
    Software engineer<br />
    who builds
    <span class="rotator">
      {roles.map((r, i) => (
        <span class="rotator-item" data-i={i} aria-hidden={i !== 0}>{r}</span>
      ))}
    </span>
  </h1>

  <p class="lede" data-reveal style="--reveal-delay:150ms">
    Four years across backend and full-stack systems in <em>TypeScript, NestJS and Node.js</em>,
    and <em>Java&nbsp;21 with Spring Boot</em>, over PostgreSQL and MySQL. I like the problems where
    being approximately right is a failure: tax documents that must file, revenue figures a customer
    will read, integrations against APIs that go down on their own schedule.
  </p>

  <div class="cta-row" data-reveal style="--reveal-delay:230ms">
    <a href="#work" class="btn btn-primary">See the work</a>
    <a href="mailto:joeljarro2@gmail.com" class="btn btn-ghost">Get in touch</a>
    <a href="https://github.com/Quirrod" target="_blank" rel="noopener" class="btn btn-ghost">GitHub</a>
  </div>

  <dl class="stats" data-reveal style="--reveal-delay:320ms">
    {stats.map((s) => (
      <div class="stat">
        <dt class="stat-value"><span data-count={s.value}>0</span>{s.suffix}</dt>
        <dd class="stat-label">{s.label}</dd>
      </div>
    ))}
  </dl>
</section>

<script is:inline>
  (function () {
    var w = document.querySelector(".rotator");
    if (!w) return;
    var items = w.querySelectorAll(".rotator-item");
    if (items.length < 2) return;
    items[0].classList.add("is-active");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var i = 0;
    setInterval(function () {
      items[i].classList.remove("is-active");
      items[i].setAttribute("aria-hidden", "true");
      i = (i + 1) % items.length;
      items[i].classList.add("is-active");
      items[i].setAttribute("aria-hidden", "false");
    }, 2800);
  })();
</script>
