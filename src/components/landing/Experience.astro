---
import { experience, skills } from "../../data/portfolio";
---
<section id="experience" class="section">
  <div data-reveal>
    <p class="eyebrow">02 — Experience</p>
    <h2 class="section-title">Where I have worked</h2>
  </div>

  <ol class="timeline">
    {experience.map((role, i) => (
      <li class="tl-item" data-reveal style={`--reveal-delay:${i * 90}ms`}>
        <span class:list={["tl-dot", role.current && "is-current"]}></span>
        <div class="tl-head">
          <h3 class="tl-title">{role.title}</h3>
          <span class="tl-company">{role.company}</span>
        </div>
        <p class="tl-meta">{role.period} · {role.location}</p>
        <ul class="tl-points">
          {role.points.map((pt) => <li>{pt}</li>)}
        </ul>
      </li>
    ))}
  </ol>

  <div class="toolkit" data-reveal>
    <p class="eyebrow">03 — Toolkit</p>
    <h2 class="section-title">What I work with</h2>
    <div class="toolkit-grid">
      {skills.map((s, i) => (
        <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <h3 class="toolkit-group">{s.group}</h3>
          <div class="tags">{s.items.map((it) => <span class="tag">{it}</span>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>
