---
import { experience, skills } from "../../data/portfolio";
---
<section id="experience" class="mx-auto max-w-5xl px-6 py-16 sm:px-8">
  <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white" data-reveal>Experience</h2>

  <ol class="mt-8 space-y-10 border-l border-zinc-200 pl-6 dark:border-zinc-800 sm:pl-8">
    {experience.map((role, i) => (
      <li class="relative" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
        <span
          class:list={[
            "absolute -left-[31px] top-1.5 h-2.5 w-2.5 rounded-full ring-4 ring-white dark:ring-zinc-950 sm:-left-[39px]",
            role.current ? "bg-orange-500" : "bg-zinc-300 dark:bg-zinc-700",
          ]}
        ></span>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="font-semibold tracking-tight text-zinc-900 dark:text-white">{role.title}</h3>
          <span class="text-sm text-zinc-500 dark:text-zinc-400">{role.company}</span>
        </div>
        <p class="mt-1 text-xs uppercase tracking-wide text-zinc-400 dark:text-zinc-500">
          {role.period} · {role.location}
        </p>
        <ul class="mt-3 space-y-2">
          {role.points.map((pt) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              <span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>

  <div class="mt-16" data-reveal>
    <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-white">Toolkit</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {skills.map((s, i) => (
        <div data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-zinc-400 dark:text-zinc-500">{s.group}</h3>
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {s.items.map((item) => <span class="tag">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
